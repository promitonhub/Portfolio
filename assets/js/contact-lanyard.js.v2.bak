import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js';

(() => {
  const contact = document.querySelector('#contact');
  const inner = contact?.querySelector('.contact-inner');
  const panel = inner?.querySelector('.contact-panel');
  if (!contact || !inner || !panel || inner.querySelector('.contact-lanyard')) return;

  const mount = document.createElement('div');
  mount.className = 'contact-lanyard';
  mount.setAttribute('aria-label', 'Interactive hanging contact identification card. Drag the card to swing it.');
  mount.innerHTML = '<canvas class="contact-lanyard-canvas" aria-hidden="true"></canvas><span class="contact-lanyard-hint">DRAG TO SWING <i>↗</i></span>';
  inner.insertBefore(mount, panel);

  let renderer;
  try {
    renderer = new THREE.WebGLRenderer({ canvas: mount.querySelector('canvas'), alpha: true, antialias: true, powerPreference: 'high-performance' });
  } catch (error) {
    mount.classList.add('contact-lanyard-fallback');
    mount.insertAdjacentHTML('afterbegin', '<div class="contact-lanyard-placeholder"><span>PM</span><b>PROMIT MITRA</b><small>CONTACT CARD · 01</small></div>');
    return;
  }

  const scene = new THREE.Scene();
  const camera = new THREE.OrthographicCamera(-2.35, 2.35, 2.35, -2.35, .1, 50);
  camera.position.set(0, 0, 12);
  const ambient = new THREE.AmbientLight(0xffffff, 1.5);
  const key = new THREE.DirectionalLight(0xe7f1dc, 2.4); key.position.set(-3, 4, 7);
  const rim = new THREE.DirectionalLight(0x91b98a, 1.25); rim.position.set(3, -1, 4);
  scene.add(ambient, key, rim);

  const CARD_W = 1.34 * .55 * 1.55 * 1.52;
  const CARD_H = CARD_W * 2.25 / 1.6;
  const STRAP_W = .44 * .6;
  const anchor = new THREE.Vector3(0, 2.12, 0);
  const strapLength = 1.63;
  const nodes = Array.from({ length: 9 }, (_, i) => new THREE.Vector3(0, anchor.y - (i / 8) * strapLength, 0));
  const previous = nodes.map(p => p.clone());
  const segmentLength = strapLength / 8;
  let gravity = 2.0;
  const damping = .994;
  let width = 1, height = 1, visible = true, raf = 0, last = 0;
  let dragging = false, pointerId = null, dragOffset = new THREE.Vector3(), releaseVelocity = new THREE.Vector3();

  const makeFace = (back = false) => {
    const c = document.createElement('canvas'); c.width = 768; c.height = 1080;
    const ctx = c.getContext('2d');
    const g = ctx.createLinearGradient(0, 0, 768, 1080);
    g.addColorStop(0, back ? '#15241b' : '#0a1009'); g.addColorStop(.58, '#0c1710'); g.addColorStop(1, '#17251a');
    ctx.fillStyle = g; ctx.fillRect(0, 0, c.width, c.height);
    ctx.strokeStyle = 'rgba(217,243,107,.22)'; ctx.lineWidth = 3; ctx.strokeRect(26, 26, 716, 1028);
    ctx.strokeStyle = 'rgba(217,243,107,.08)'; ctx.lineWidth = 1;
    for (let y = 80; y < 1080; y += 54) { ctx.beginPath(); ctx.moveTo(28, y); ctx.lineTo(740, y); ctx.stroke(); }
    ctx.fillStyle = '#d9f36b'; ctx.font = '700 78px Arial'; ctx.fillText('P.', 68, 145);
    ctx.fillStyle = 'rgba(240,240,236,.78)'; ctx.font = '600 31px monospace'; ctx.fillText(back ? 'INDEPENDENT PORTFOLIO' : 'PROMIT MITRA', 68, 790);
    ctx.fillStyle = 'rgba(217,243,107,.78)'; ctx.font = '22px monospace'; ctx.fillText(back ? 'KOLKATA · INDIA' : 'BUSINESS / SYSTEMS / DESIGN', 68, 842);
    ctx.fillStyle = 'rgba(240,240,236,.4)'; ctx.font = '18px monospace'; ctx.fillText(back ? 'PROMIT.QD.JE' : 'CONTACT CARD  /  01', 68, 970);
    ctx.save(); ctx.translate(384, 470); ctx.rotate(-.16); ctx.fillStyle = 'rgba(217,243,107,.055)'; ctx.font = '900 260px Arial'; ctx.fillText('PM', -150, 85); ctx.restore();
    const tex = new THREE.CanvasTexture(c); tex.colorSpace = THREE.SRGBColorSpace; tex.anisotropy = 8; return tex;
  };
  const frontTex = makeFace(false), backTex = makeFace(true);
  const shape = new THREE.Shape();
  const r = .095, x = CARD_W / 2, y = CARD_H / 2;
  shape.moveTo(-x + r, -y); shape.lineTo(x - r, -y); shape.quadraticCurveTo(x, -y, x, -y + r);
  shape.lineTo(x, y - r); shape.quadraticCurveTo(x, y, x - r, y); shape.lineTo(-x + r, y);
  shape.quadraticCurveTo(-x, y, -x, y - r); shape.lineTo(-x, -y + r); shape.quadraticCurveTo(-x, -y, -x + r, -y);
  const cardGeo = new THREE.ExtrudeGeometry(shape, { depth: .035, bevelEnabled: true, bevelSegments: 3, steps: 1, bevelSize: .018, bevelThickness: .012, curveSegments: 8 });
  cardGeo.center();
  const cardMat = new THREE.MeshPhysicalMaterial({ color: '#0a1009', roughness: .42, metalness: .04, clearcoat: 1, clearcoatRoughness: .08 });
  const card = new THREE.Mesh(cardGeo, cardMat); scene.add(card);
  const faceGeo = new THREE.PlaneGeometry(CARD_W - .045, CARD_H - .045);
  const front = new THREE.Mesh(faceGeo, new THREE.MeshBasicMaterial({ map: frontTex, side: THREE.DoubleSide })); front.position.z = .034; card.add(front);
  const back = new THREE.Mesh(faceGeo, new THREE.MeshBasicMaterial({ map: backTex, side: THREE.DoubleSide })); back.position.z = -.034; back.rotation.y = Math.PI; card.add(back);

  const metal = new THREE.MeshStandardMaterial({ color: '#aab3a0', metalness: .82, roughness: .24 });
  const ring = new THREE.Mesh(new THREE.TorusGeometry(.115, .018, 10, 32), metal); ring.position.set(0, CARD_H / 2 + .09, 0); card.add(ring);
  const eyelet = new THREE.Mesh(new THREE.CylinderGeometry(.055, .055, .04, 24), metal); eyelet.rotation.x = Math.PI / 2; eyelet.position.set(0, CARD_H / 2 - .005, 0); card.add(eyelet);
  const clip = new THREE.Mesh(new THREE.BoxGeometry(.23, .12, .055), new THREE.MeshStandardMaterial({ color: '#788574', metalness: .7, roughness: .3 })); clip.position.set(0, CARD_H / 2 + .025, 0); card.add(clip);

  const strapMat = new THREE.MeshStandardMaterial({ color: '#223c32', roughness: .74, metalness: .02, side: THREE.DoubleSide });
  const strapGeo = new THREE.BufferGeometry();
  const sampleCount = 56;
  const positions = new Float32Array(sampleCount * 2 * 3);
  const uvs = new Float32Array(sampleCount * 2 * 2);
  const indices = [];
  for (let i = 0; i < sampleCount; i++) { uvs[i * 4] = 0; uvs[i * 4 + 1] = i / (sampleCount - 1); uvs[i * 4 + 2] = 1; uvs[i * 4 + 3] = i / (sampleCount - 1); if (i < sampleCount - 1) { const a = i * 2; indices.push(a, a + 1, a + 2, a + 1, a + 3, a + 2); } }
  strapGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3)); strapGeo.setAttribute('uv', new THREE.BufferAttribute(uvs, 2)); strapGeo.setIndex(indices);
  const strap = new THREE.Mesh(strapGeo, strapMat); strap.frustumCulled = false; scene.add(strap);
  const stitchMat = new THREE.MeshBasicMaterial({ color: '#a8bd8e', transparent: true, opacity: .46 });
  const stitchLine = new THREE.Line(new THREE.BufferGeometry(), stitchMat); scene.add(stitchLine);

  const raycaster = new THREE.Raycaster(), pointer = new THREE.Vector2(), dragPlane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0), hit = new THREE.Vector3();
  const getPoint = e => { const rect = renderer.domElement.getBoundingClientRect(); pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1; pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1; raycaster.setFromCamera(pointer, camera); return raycaster.ray.intersectPlane(dragPlane, hit) ? hit.clone() : null; };
  const onDown = e => { const p = getPoint(e); if (!p) return; if (raycaster.intersectObject(card, true).length) { dragging = true; pointerId = e.pointerId; dragOffset.copy(card.position).sub(p); releaseVelocity.set(0, 0, 0); renderer.domElement.setPointerCapture(e.pointerId); renderer.domElement.style.cursor = 'grabbing'; e.preventDefault(); } };
  const onMove = e => { const p = getPoint(e); if (!p) return; if (dragging && e.pointerId === pointerId) { const target = p.add(dragOffset); target.x = THREE.MathUtils.clamp(target.x, -1.5, 1.5); target.y = THREE.MathUtils.clamp(target.y, -1.9, 1.45); releaseVelocity.copy(target).sub(card.position).multiplyScalar(18); card.position.copy(target); const top = new THREE.Vector3(target.x, target.y + CARD_H / 2, 0); nodes[8].lerp(top, .8); previous[8].copy(nodes[8]); } else { raycaster.setFromCamera(pointer, camera); renderer.domElement.style.cursor = raycaster.intersectObject(card, true).length ? 'grab' : 'default'; } };
  const onUp = e => { if (dragging && e.pointerId === pointerId) { dragging = false; pointerId = null; renderer.domElement.style.cursor = 'grab'; } };
  renderer.domElement.style.touchAction = 'pan-y';
  renderer.domElement.addEventListener('pointerdown', onDown); renderer.domElement.addEventListener('pointermove', onMove); renderer.domElement.addEventListener('pointerup', onUp); renderer.domElement.addEventListener('pointercancel', onUp);

  const updateStrap = () => {
    const points = nodes.map(p => p.clone());
    points[points.length - 1].copy(card.position).add(new THREE.Vector3(0, CARD_H / 2 + .07, 0));
    const curve = new THREE.CatmullRomCurve3(points);
    const verts = strapGeo.attributes.position.array;
    const stitchPts = [];
    for (let i = 0; i < sampleCount; i++) { const t = i / (sampleCount - 1); const p = curve.getPoint(t); const tangent = curve.getTangent(t); const side = new THREE.Vector3(-tangent.y, tangent.x, 0).normalize().multiplyScalar(STRAP_W / 2); const a = p.clone().add(side), b = p.clone().sub(side); verts.set([a.x,a.y,a.z,b.x,b.y,b.z], i * 6); if (i % 4 === 0) stitchPts.push(a.clone().add(new THREE.Vector3(0,0,.008))); }
    strapGeo.attributes.position.needsUpdate = true; strapGeo.computeVertexNormals();
    stitchLine.geometry.dispose(); stitchLine.geometry = new THREE.BufferGeometry().setFromPoints(stitchPts);
  };

  const resize = () => { const rect = mount.getBoundingClientRect(); width = Math.max(1, rect.width); height = Math.max(1, rect.height); renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2)); renderer.setSize(width, height, false); const aspect = width / height; const viewH = 4.15; camera.left = -viewH * aspect / 2; camera.right = viewH * aspect / 2; camera.top = viewH / 2; camera.bottom = -viewH / 2; camera.updateProjectionMatrix(); };
  const resizeObserver = new ResizeObserver(resize); resizeObserver.observe(mount); resize();
  const intersection = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible) start(); }); intersection.observe(contact);
  const step = (dt) => {
    if (!dragging) {
      for (let i = 1; i < nodes.length; i++) { const current = nodes[i].clone(); const velocity = nodes[i].clone().sub(previous[i]).multiplyScalar(damping); previous[i].copy(current); nodes[i].add(velocity).add(new THREE.Vector3(0, -gravity * dt * dt, 0)); }
      nodes[0].copy(anchor);
      for (let k = 0; k < 5; k++) { nodes[0].copy(anchor); for (let i = 0; i < 8; i++) { const delta = nodes[i + 1].clone().sub(nodes[i]); const len = delta.length() || .0001; const correction = delta.multiplyScalar((len - segmentLength) / len); if (i === 0) nodes[i + 1].sub(correction); else { nodes[i].addScaledVector(correction, .5); nodes[i + 1].sub(correction.multiplyScalar(.5)); } } }
      const end = nodes[8]; const target = end.clone().add(new THREE.Vector3(0, -CARD_H / 2 - .07, 0));
      card.position.lerp(target, .82);
      const swing = Math.atan2(nodes[8].x - nodes[7].x, nodes[8].y - nodes[7].y);
      card.rotation.z = THREE.MathUtils.damp(card.rotation.z, -swing * .78, 7, dt);
      card.rotation.x = THREE.MathUtils.damp(card.rotation.x, .035 * Math.sin(performance.now() * .0007), 2, dt);
      nodes[8].lerp(card.position.clone().add(new THREE.Vector3(0, CARD_H / 2 + .07, 0)), .7);
    }
  };
  function start() { if (!raf && visible) raf = requestAnimationFrame(render); }
  const render = now => { raf = 0; if (!visible || document.hidden) return; const dt = Math.min(.033, Math.max(.001, (now - (last || now)) / 1000)); last = now; step(dt); updateStrap(); renderer.render(scene, camera); raf = requestAnimationFrame(render); };
  document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) { gravity = .6; }
  start();

  window.addEventListener('pagehide', () => { cancelAnimationFrame(raf); resizeObserver.disconnect(); intersection.disconnect(); renderer.domElement.removeEventListener('pointerdown', onDown); renderer.domElement.removeEventListener('pointermove', onMove); renderer.domElement.removeEventListener('pointerup', onUp); renderer.dispose(); frontTex.dispose(); backTex.dispose(); cardGeo.dispose(); faceGeo.dispose(); strapGeo.dispose(); });
})();
