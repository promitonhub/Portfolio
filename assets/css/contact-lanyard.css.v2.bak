/* Contact composition v2 — preserve the original panel scale, give the lanyard its own column. */
#contact .contact-inner {
  position: relative;
  display: grid;
  width: min(1480px, calc(100% - 80px));
  max-width: none;
  margin-inline: auto;
  grid-template-columns: minmax(340px, .72fr) minmax(700px, 1.6fr);
  align-items: stretch;
  gap: clamp(36px, 4vw, 64px);
}
#contact .contact-lanyard {
  position: relative;
  z-index: 1;
  align-self: stretch;
  min-width: 0;
  min-height: 440px;
  height: 100%;
  overflow: visible;
  isolation: isolate;
  touch-action: pan-y;
}
#contact .contact-lanyard-canvas {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 440px;
  outline: none;
  touch-action: pan-y;
  cursor: grab;
}
#contact .contact-lanyard-canvas:active { cursor: grabbing; }
#contact .contact-lanyard-hint {
  position: absolute;
  left: 8%;
  bottom: 12px;
  color: var(--faint);
  font: 8px var(--mono);
  letter-spacing: .14em;
  pointer-events: none;
  white-space: nowrap;
}
#contact .contact-lanyard-hint i { color: var(--accent); font-style: normal; }
#contact .contact-panel {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 440px;
  margin: 0;
  justify-self: stretch;
}
#contact .contact-lanyard-placeholder {
  position: absolute;
  top: 30px;
  left: 50%;
  display: flex;
  width: 210px;
  height: 300px;
  flex-direction: column;
  justify-content: space-between;
  padding: 24px;
  transform: translateX(-50%);
  border: 1px solid rgba(217,243,107,.38);
  border-radius: 3px;
  background: linear-gradient(145deg,#15251a,#08100b 72%);
  box-shadow: 0 22px 65px rgba(0,0,0,.42), inset 0 0 0 5px rgba(217,243,107,.035);
  color: var(--ink);
  font-family: var(--mono);
}
#contact .contact-lanyard-placeholder span { color: var(--accent); font: 800 42px var(--display); }
#contact .contact-lanyard-placeholder b { font-size: 11px; letter-spacing: .12em; }
#contact .contact-lanyard-placeholder small { color: var(--muted); font-size: 8px; letter-spacing: .1em; }
@media (max-width: 1120px) {
  #contact .contact-inner {
    width: min(100% - 48px, 980px);
    grid-template-columns: minmax(260px, .68fr) minmax(0, 1.32fr);
    gap: 28px;
  }
  #contact .contact-panel { min-height: 420px; }
  #contact .contact-lanyard, #contact .contact-lanyard-canvas { min-height: 420px; }
}
@media (max-width: 820px) {
  #contact .contact-inner {
    width: min(100% - 36px, 680px);
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }
  #contact .contact-lanyard { height: 360px; min-height: 360px; }
  #contact .contact-lanyard-canvas { height: 360px; min-height: 360px; }
  #contact .contact-lanyard-hint { left: 4%; bottom: 4px; }
  #contact .contact-panel { min-height: 440px; }
}
@media (max-width: 480px) {
  #contact .contact-inner { width: calc(100% - 28px); }
  #contact .contact-lanyard, #contact .contact-lanyard-canvas { height: 320px; min-height: 320px; }
  #contact .contact-panel { min-height: 500px; }
}
